/target
.DS_Store

# Generated tile archives (e.g. example/demo output).
*.mbtiles
*.pmtiles

# Benchmark head-to-head inputs and downloaded upstream artifacts (large binaries).
# bench/results/ is intentionally tracked for regression history.
/parity/upstream/
/parity/data/

# Local Claude Code config -- not part of the project
CLAUDE.md
CLAUDE.local.md
.claude/

# Planetiler's default scratch dir (spawned when benchmarking the jar from the repo root)
/data/

# Cloud benchmark run artifacts (fetched per run; curated numbers go to bench/results)
services/cloud-runner/results/

# JS workspace (pnpm): installs and app build output
node_modules/
/apps/*/dist/

# Cross-built runner-live binary the backend stack ships as a CDK asset
# (just runner::build-backend / .github/workflows/backend.yml)
/infra/runner/dist-backend/

# Musl-built run-api Lambda bootstrap the api stack ships as a CDK asset
# (just runner::build-api / .github/workflows/api.yml)
/infra/runner/dist-api/

# CDK context cache: embeds the AWS account id, and CI re-derives it through
# the bootstrap lookup role — never commit it.
cdk.context.json

# Local copy of the deployed runner auth config, for exercising real sign-in
# from `pnpm dev` (apps/runner/README.md -> Auth). The deploy publishes its
# own config.json, so this never ships.
/apps/runner/public/config.json
