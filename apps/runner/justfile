set shell := ["bash", "-cu"]

# Build the production console into dist/.
build:
    pnpm install
    pnpm run build

# Build + publish: the CDK BucketDeployment ships dist/ and invalidates
# CloudFront as part of the deploy. Requires default AWS creds and
# ../../infra/runner/.env (see .env.example there).
deploy: build
    cd ../../infra/runner && bun install && npx cdk deploy --require-approval never

# Show what a deploy would change without applying it.
diff: build
    cd ../../infra/runner && bun install && npx cdk diff
