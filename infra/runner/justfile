set shell := ["bash", "-cu"]

# Install the workspace and build the console into apps/runner/dist.
build:
    pnpm install
    pnpm --filter @planetiler-rs/runner build

# Build + publish: the CDK BucketDeployment ships apps/runner/dist and
# invalidates CloudFront as part of the deploy. Local fallback — CI deploys on
# merge to main. Requires default AWS creds and ./.env (see .env.example).
deploy: build
    pnpm exec cdk deploy RunnerConsoleStack --require-approval never

# Show what a deploy would change without applying it.
diff: build
    pnpm exec cdk diff RunnerConsoleStack

# Cross-build the runner-live release binary for the backend box
# (aarch64-linux, glibc-matched to Ubuntu 24.04) into ./dist-backend.
# Named volumes keep the container's target/registry caches off the host
# target dir, so macOS and Linux artifacts never mix.
build-backend:
    docker run --rm --platform linux/arm64 \
      -v "$(git rev-parse --show-toplevel)":/src -w /src \
      -v planetiler-backend-target:/target -e CARGO_TARGET_DIR=/target \
      -v planetiler-backend-registry:/usr/local/cargo/registry \
      rust:1-bookworm \
      bash -c "cargo build -p runner-live --release --locked && cp /target/release/runner-live /src/infra/runner/dist-backend-out"
    mkdir -p dist-backend && mv dist-backend-out dist-backend/runner-live

# Deploy the SSE backend (#59): t4g.nano + Caddy at live.runner.johncarmack.com.
# A changed binary replaces the instance (its asset hash rides in user-data).
deploy-backend: build-backend
    pnpm install
    pnpm exec cdk deploy RunnerBackendStack --require-approval never

diff-backend: build-backend
    pnpm install
    pnpm exec cdk diff RunnerBackendStack

# Build the run-api Lambda bootstrap (aarch64 musl static — provided.al2023's
# glibc is older than any host we build on, so static sidesteps the mismatch)
# into ./dist-api/bootstrap. Same containerized pattern as build-backend.
build-api:
    docker run --rm --platform linux/arm64 \
      -v "$(git rev-parse --show-toplevel)":/src -w /src \
      -v planetiler-api-target:/target -e CARGO_TARGET_DIR=/target \
      -v planetiler-api-registry:/usr/local/cargo/registry \
      rust:1-bookworm \
      bash -c "apt-get update -qq >/dev/null && apt-get install -y -qq musl-tools >/dev/null \
        && rustup target add aarch64-unknown-linux-musl >/dev/null 2>&1 \
        && cargo build -p run-api --profile lambda --locked --target aarch64-unknown-linux-musl \
        && cp /target/aarch64-unknown-linux-musl/lambda/run-api /src/infra/runner/dist-api-out"
    mkdir -p dist-api && mv dist-api-out dist-api/bootstrap

# Deploy the dispatch API (#59): Lambda + HTTP API + JWT authorizer at
# api.runner.johncarmack.com. Needs RunnerConsoleStack deployed first (it
# publishes the pool/client SSM parameters the authorizer reads).
deploy-api: build-api
    pnpm install
    pnpm exec cdk deploy RunApiStack --require-approval never

diff-api: build-api
    pnpm install
    pnpm exec cdk diff RunApiStack
