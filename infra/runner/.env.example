# Copy to .env (gitignored). The planetiler.rs hosted zone the records live
# in (PlanetilerRsZoneStack, infra/dns) — look it up with:
#   aws route53 list-hosted-zones --query "HostedZones[?Name=='planetiler.rs.']"
RUNNER_ZONE_ID=
RUNNER_ZONE_NAME=planetiler.rs
RUNNER_DOMAIN=runner.planetiler.rs

# Auth (see apps/runner/README.md → Auth). Leave RUNNER_SAML_METADATA_URL
# empty until the one-time Identity Center app exists; sign-in then uses a
# single Cognito-local user (RUNNER_OWNER_EMAIL, temp password by email).
# The hosted-UI prefix predates the domain move; changing it would force the
# one-time Identity Center SAML wiring to be redone, so it stays.
RUNNER_SAML_METADATA_URL=
RUNNER_OWNER_EMAIL=johncarmack@me.com
RUNNER_AUTH_DOMAIN_PREFIX=runner-johncarmack
