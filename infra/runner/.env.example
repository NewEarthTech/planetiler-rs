# Copy to .env (gitignored). The parent hosted zone the subdomain records
# live in — look it up with:
#   aws route53 list-hosted-zones --query "HostedZones[?Name=='johncarmack.com.']"
RUNNER_ZONE_ID=
RUNNER_ZONE_NAME=johncarmack.com
RUNNER_DOMAIN=runner.johncarmack.com

# Auth (see apps/runner/README.md → Auth). Leave RUNNER_SAML_METADATA_URL
# empty until the one-time Identity Center app exists; sign-in then uses a
# single Cognito-local user (RUNNER_OWNER_EMAIL, temp password by email).
RUNNER_SAML_METADATA_URL=
RUNNER_OWNER_EMAIL=johncarmack@me.com
RUNNER_AUTH_DOMAIN_PREFIX=runner-johncarmack
