set shell := ["bash", "-cu"]

# Install the workspace and build the dashboard into apps/docs/dist.
build:
    pnpm install
    pnpm --filter @planetiler-rs/docs build

# Build + publish: the CDK BucketDeployment ships apps/docs/dist and
# invalidates CloudFront as part of the deploy. Requires default AWS creds and
# ./.env (see .env.example). (GeobenchStack/geobench.johncarmack.com is a
# different project — johncarmack1984/geo-desktop-bench — not this site.)
deploy: build
    pnpm exec cdk deploy --require-approval never

# Show what a deploy would change without applying it.
diff: build
    pnpm exec cdk diff
