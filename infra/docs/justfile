set shell := ["bash", "-cu"]

# Install the workspace and build the dashboard into apps/docs/dist.
build:
    pnpm install
    pnpm --filter @planetiler-rs/docs build

# Build + publish planetiler.rs: the splash placeholder at the root and the
# dashboard under /benchmarks, both shipped by the stack's BucketDeployments
# with a CloudFront invalidation. Requires default AWS creds and ./.env (see
# .env.example). (GeobenchStack/geobench.johncarmack.com is a different
# project — johncarmack1984/geo-desktop-bench — not this site.)
deploy: build
    pnpm exec cdk deploy --require-approval never

# Show what a deploy would change without applying it.
diff: build
    pnpm exec cdk diff
